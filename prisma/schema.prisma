generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  ADMIN
  MEMBER
}

enum ScanStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum IssueStatus {
  OPEN
  FIXED
  IGNORED
}

enum IssueSource {
    AI
    ANALYZER
}

enum SuggestionStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum SuggestionsApplyStatus {
  IN_PROGRESS
  COMPLETED
  PARTIAL
  FAILED
}

enum SuggestionsApplyItemStatus {
  PENDING
  APPLIED
  FAILED
}

enum ApplyMethod {
  AI
  STATIC
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Category {
  CODE_SMELL
  DEAD_CODE
  DUPLICATE
  COMPLEXITY
  SRP_VIOLATION
  SECURITY
  PERFORMANCE
  FUNCTIONALITY
  OTHER
}

enum Provider {
  GITHUB
}

// --- MODELS ---

model User {
  id                   Int       @id @default(autoincrement())
  githubId             BigInt    @unique @map("github_id")
  email                String?   @unique
  username             String    @unique
  avatarUrl            String?   @map("avatar_url")
  githubAccessToken    String?   @map("github_access_token")
  githubRefreshToken   String?   @map("github_refresh_token")
  githubTokenExpiresAt DateTime? @map("github_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  projects         ProjectMember[]
  sessions         Session[]
  scans            Scan[]
  suggestionsApplies SuggestionsApply[]

  @@map("users")
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id                   Int       @id @default(autoincrement())
  name                 String
  repoUrl              String    @map("repo_url")
  provider             Provider  @default(GITHUB)
  githubRepoId         BigInt    @unique @map("github_repo_id")
  owner                String
  repoName             String    @map("repo_name")
  installationId       BigInt?   @map("installation_id")
  lastScanDate         DateTime? @map("last_scan_date")
  lastScannedCommitSha String?   @map("last_scanned_commit_sha")
  projectSummary       String?   @map("project_summary")
  projectBrief         String?   @map("project_brief")
  summaryGeneratedAt   DateTime? @map("summary_generated_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  members           ProjectMember[]
  scans             Scan[]
  issues            Issue[]
  suggestions       Suggestion[]
  analytics         Analytics[]
  suggestionsApplies SuggestionsApply[]

  @@unique([provider, githubRepoId])
  @@map("projects")
}

model ProjectMember {
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      Role     @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Scan {
  id          Int        @id @default(autoincrement())
  projectId   Int        @map("project_id")
  initiatorId Int?       @map("initiator_id")
  branchName  String     @map("branch_name")
  commitSha   String?    @map("commit_sha")
  status      ScanStatus @default(IN_PROGRESS)
  modelUsed   String?    @map("model_used")
  tokensUsed  Int?       @map("tokens_used")
  durationMs  Int?       @map("duration_ms")
  scanDate    DateTime   @default(now()) @map("scan_date")

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  initiator         User?       @relation(fields: [initiatorId], references: [id], onDelete: SetNull)
  issues            Issue[]
  analytics         Analytics[]
  suggestions       Suggestion[]
  suggestionsApplies SuggestionsApply[]

  @@index([projectId])
  @@map("scans")
}

model Issue {
  id          Int         @id @default(autoincrement())
  projectId   Int         @map("project_id")
  scanId      Int         @map("scan_id")
  filePath    String      @map("file_path")
  lineNumber  Int         @map("line_number")
  severity    Severity
  category    Category
  summary     String
  explanation String?
  codeSnippet String?      @map("code_snippet")
  status      IssueStatus @default(OPEN)
  source      IssueSource @default(ANALYZER)
  detectedAt  DateTime    @default(now()) @map("detected_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan        Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  suggestions Suggestion[]

  @@index([scanId])
  @@map("issues")
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  projectId   Int              @map("project_id")
  scanId      Int              @map("scan_id")
  issueId     Int              @map("issue_id")
  summary     String
  explanation String?
  diffPatch   String           @map("diff_patch")
  status      SuggestionStatus @default(PENDING)
  generatedAt DateTime         @default(now()) @map("generated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan    Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  suggestionItems SuggestionsApplyItem[]

  @@index([issueId])
  @@map("suggestions")
}

model SuggestionsApply {
  id          Int                   @id @default(autoincrement())
  projectId   Int                   @map("project_id")
  scanId      Int                   @map("scan_id")
  userId      Int                   @map("user_id")
  branchName  String?               @map("branch_name")
  prUrl       String?               @map("pr_url")
  status      SuggestionsApplyStatus @default(IN_PROGRESS)
  error       String?
  createdAt   DateTime              @default(now()) @map("created_at")
  finishedAt  DateTime?             @map("finished_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan        Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  suggestionItems SuggestionsApplyItem[]

  @@index([projectId])
  @@index([status, createdAt])
  @@map("suggestion_applies")
}

model SuggestionsApplyItem {
  id                Int                   @id @default(autoincrement())
  suggestionsApply  SuggestionsApply      @relation(fields: [suggestionsApplyId], references: [id], onDelete: Cascade)
  suggestionsApplyId Int                  @map("suggestion_apply_id")
  suggestion        Suggestion            @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  suggestionId      Int                   @map("suggestion_id")
  status            SuggestionsApplyItemStatus @default(PENDING)
  error             String?
  applyMethod       ApplyMethod?          @map("apply_method")

  @@unique([suggestionsApplyId, suggestionId])
  @@index([suggestionId])
  @@map("suggestion_apply_items")
}

model Analytics {
  id                   Int      @id @default(autoincrement())
  projectId            Int      @map("project_id")
  scanId               Int      @map("scan_id")
  avgComplexity        Float    @map("avg_complexity")
  technicalDebtScore   Int      @map("technical_debt_score")
  severityDistribution Json     @map("severity_distribution")
  generatedAt          DateTime @default(now()) @map("generated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan    Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId])
  @@index([projectId])
  @@map("analytics")
}
