NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@localhost:5432/<DB_NAME>"
FRONTEND_URL=http://localhost:3000

GITHUB_APP_ID=app_id_in_github
GITHUB_APP_BOT_LOGIN=your-app-slug[bot]
GITHUB_CLIENT_ID=client_id_in_github
GITHUB_CLIENT_SECRET=client_secret_in_github
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback
GITHUB_WEBHOOK_SECRET=webhook_secret_in_github
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_FETCH_CONCURRENCY=5

JWT_ACCESS_SECRET=random_32chars_string
JWT_REFRESH_SECRET=random_32chars_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

ENCRYPTION_KEY=random_64chars_hex_string

GROQ_API_KEY=your_groq_api_key
REDIS_URL=redis://localhost:6379
