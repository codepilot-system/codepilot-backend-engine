{
  "name": "codepilot-backend-engine",
  "version": "1.0.0",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/src/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:webhook\"",
    "dev:server": "nodemon --watch src --exec ts-node src/server.ts",
    "dev:webhook": "node -e \"require('dotenv').config(); const Smee = require('smee-client'); new Smee({ source: process.env.GITHUB_WEBHOOK_PROXY_URL, target: 'http://localhost:5000/api/webhooks/github', logger: console }).start()\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@octokit/request-error": "^7.1.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "axios": "^1.15.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "groq-sdk": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "octokit": "^5.0.5",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.7.0",
    "smee-client": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
